# Config file for the Iridescence package
#
# Usage from an external project:
#
#  find_package(Iridescence REQUIRED)
#  target_link_libraries(MY_TARGET_NAME Iridescence::Iridescence)
#
@PACKAGE_INIT@

include_guard()
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(OpenGL REQUIRED)
find_dependency(Eigen3 REQUIRED)
find_dependency(PNG)
find_dependency(JPEG)
find_dependency(glfw3 QUIET)

if(NOT TARGET glfw)
  set(_iridescence_glfw_lib "${PACKAGE_PREFIX_DIR}/lib/libglfw.so")
  if(EXISTS "${_iridescence_glfw_lib}")
    add_library(glfw SHARED IMPORTED)
    set_target_properties(glfw PROPERTIES IMPORTED_LOCATION "${_iridescence_glfw_lib}")
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/iridescence-targets.cmake")
add_library(Iridescence::Iridescence ALIAS Iridescence::iridescence)
